{
  "ConnectionStrings": {
    "TallyJ4": "Server=<SERVER>;Database=TallyJ4;User Id=<USER>;Password=<PASSWORD>;TrustServerCertificate=True"
  },
  "Database": {
    "SeedOnStartup": false,
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "TallyJ4API",
    "Audience": "TallyJ4Client",
    "Key": "<REPLACE-WITH-MINIMUM-32-CHARACTER-SECRET-KEY>",
    "ExpiryMinutes": 60
  },
  "AllowedOrigins": [
    "https://localhost:8095",
    "https://localhost:4173",
    "http://localhost:8095",
    "http://localhost:4173"
  ],
  "Sentry": "<SENTRY-DSN>",
  "GreenApi": {
    "IdInstance": "<GREEN-API-INSTANCE-ID>",
    "ApiToken": "<GREEN-API-TOKEN>",
    "BaseUrl": "https://api.green-api.com"
  },
  "Twilio": {
    "AccountSid": "<TWILIO-ACCOUNT-SID>",
    "AuthToken": "<TWILIO-AUTH-TOKEN>",
    "FromNumber": "<TWILIO-FROM-NUMBER>"
  },
  "Email": {
    "SmtpHost": "<SMTP-HOST>",
    "SmtpPort": 587,
    "UseSsl": true,
    "Username": "<EMAIL-USERNAME>",
    "Password": "<EMAIL-PASSWORD>",
    "FromAddress": "<FROM-EMAIL-ADDRESS>",
    "FromName": "TallyJ4"
  },
  "ifttt": {
    "webhook": "<IFTTT-WEBHOOK-URL>"
  },
  "SuperAdmin": {
    "Emails": [
      "admin@tallyj.test"
    ]
  },
  "TellerLoginProtection": {
    "MaxConsecutiveFailures": 10,
    "CooldownMinutes": 15,
    "MinimumPasscodeLength": 6
  },
  "AntiAbuse": {
    "ElectionPaidSendAllowance": 25,
    "OwnerDailyPaidSendCap": 100,
    "AlertThrottleHours": 24,
    "AlertEmails": [],
    "FlaggedEntryThreshold": 3,
    "ElectionBadContactCap": 10,
    "ConsecutivePhoneRunLength": 4,
    "DefaultPhoneRegionCode": "CA",
    "MxLookupTimeoutSeconds": 3,
    "MxLookupParallelism": 8,
    "PhonePrefixSendLimit": 100,
    "PhonePrefixWindowMinutes": 60,
    "PhonePrefixDigits": 6,
    "RequestCodeMinimumMilliseconds": 200
  },
  "Telegram": {
    "BotToken": ""
  },
  "Kakao": {
    "ApiAdminKey": ""
  },
  "GoogleClientSecret": "<GOOGLE-CLIENT-SECRET>",
  "ClientEnv": {
    "env": "development",
    "apiUrl": "http://localhost:5016",
    "frontendUrl": "https://localhost:8095",
    "sentryDsn": "<SENTRY-DSN-FOR-FRONTEND>",
    "googleClientId": "<GOOGLE-CLIENT-ID>",
    "facebookAppId": "<FACEBOOK-APP-ID>",
    "kakaoApiJsKey": "<KAKAO-JS-KEY>",
    "telegramBotUsername": "<TELEGRAM-BOT-USERNAME>",
    "enableTelegramLogin": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-production-domain.com",
      "https://www.your-production-domain.com"
    ]
  },
  "Encryption": {
    "Key": "<REPLACE-WITH-MINIMUM-32-CHARACTER-ENCRYPTION-KEY>"
  },
  "Facebook": {
    "BaseUrl": "https://graph.facebook.com"
  },
  "KakaoApi": {
    "BaseUrl": "https://kapi.kakao.com"
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        // HttpClient Information logs include the full request URL. The IFTTT webhook key is in that URL.
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Localization": {
    // Relative to the content root (backend/ in development). A missing directory is skipped with a debug log, including published builds that do not ship frontend/src/locales. A locales folder next to the app is also accepted.
    "ResourcesPath": "../frontend/src/locales"
  },
  // TrustPlatformProxy (default true) applies X-Forwarded-For and X-Forwarded-Proto from one hop, and only when the TCP peer is an infrastructure address: loopback, RFC 1918, 169.254.0.0/16 (Azure App Service, including ::ffff:169.254.129.1), fc00::/7, or fe80::/10. A public client that connects directly is not trusted, so IIS in-process (web.config, hostingModel=inprocess, which does not add X-Forwarded-For) and a directly exposed Kestrel ignore a client-supplied XFF. nginx or Apache on loopback is trusted. KnownProxies adds extra proxy IPs or CIDRs (a public load balancer). Set TrustPlatformProxy false to ignore the headers entirely.
  "ForwardedHeaders": {
    "TrustPlatformProxy": true,
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      // Same category as the Serilog override. This host logs through Serilog; the level is set here too so a non-Serilog sink does not write the IFTTT URL.
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  }
}
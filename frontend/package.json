{
  "name": "tallyj-4",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run gen && vite",
    "gen": "npx @hey-api/openapi-ts --file ../openApi/config.backend.ts",
    "build": "npm run merge-locales && vite build",
    "merge-locales": "node merge-locales.js",
    "preview": "vite preview",
    "tsc": "vue-tsc --noEmit",
    "lint": "eslint src --ext .js,.ts,.tsx,.vue --cache",
    "check": "npm run tsc && npm run lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:failures": "vitest run --reporter=verbose --hideSkippedTests",
    "test:coverage": "vitest run --coverage",
    "validate:i18n": "node src/locales/validate-translations.js"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@microsoft/signalr": "^10.0.11",
    "@sentry/vue": "^10.75.3",
    "chart.js": "^4.5.1",
    "element-plus": "^2.14.6",
    "luxon": "^3.7.2",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-country-flag-next": "^2.3.2",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.97.3",
    "@pinia/testing": "^1.0.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^25.9.8",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "less": "^4.9.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "glob": "^13.0.6",
    "js-yaml": "4.3.2",
    "minimatch": "^10.2.1",
    "vue-i18n": "^11.4.12",
    "vite-plugin-devtools-json": {
      "vite": "$vite"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}

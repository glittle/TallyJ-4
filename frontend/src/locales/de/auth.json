  },
  "auth.landing.features.flexible.description": {
    "t": "Unterstützt persönliche Stimmzettel, per Post versandte oder abgegebene Stimmzettel, Online-Abstimmungen und Delegiertenwahlen. Du kannst den Prozess so konfigurieren, dass er den Bedürfnissen deiner Community entspricht.",
    "s": "ai",
    "w": "2026-10-15T17:15:00Z"
  },

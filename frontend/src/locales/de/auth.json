  "auth.landing.description": {
    "t": "TallyJ ist ein sicheres und einfach zu bedienendes Wahlmanagementsystem, das in erster Linie für Bahá'í-Gemeinden entwickelt wurde. Es bietet eine vollständige Plattform zur Verwaltung von Wahlen, Personen, Stimmzetteln und Echtzeit-Zählung.",
    "s": "ai",
    "w": "2026-10-15T17:15:00Z"
  },
  "auth.landing.features.accessible.description": {
    "t": "Klare und intuitive Benutzeroberfläche, die für alle Fähigkeitsstufen geeignet ist. Geführte Schritte machen das Wahlmanagement einfach.",

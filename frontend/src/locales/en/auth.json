  "auth.landing.description": {
    "t": "TallyJ is a secure and easy-to-use election management system built primarily for Bahá'í communities. It provides a complete platform to manage elections, people, ballots, and real-time tallying.",
    "s": "source",
    "w": "2026-09-23T17:47:03Z"
  },
  "auth.landing.features.accessible.description": {
    "t": "Clear and intuitive interface that works for all skill levels. Guided steps make election management straightforward.",
    "s": "source",
    "w": "2026-09-23T17:47:03Z"
  },
  "auth.landing.features.accessible.title": {
    "t": "Easy to Use",
    "s": "source",
    "w": "2026-09-23T17:47:03Z"
  },
  "auth.landing.features.flexible.description": {
    "t": "Supports in-person ballots, mailed or dropped-off ballots, online voting, and delegate elections. You can configure the process to fit your community's needs.",
    "s": "source",
    "w": "2026-09-23T17:47:03Z"
  },
  "auth.landing.features.flexible.title": {
    "t": "Flexible Voting Options",
    "s": "source",
    "w": "2026-09-23T17:47:03Z"
  },
  "auth.landing.features.multilingual.description": {
    "t": "The interface is available in multiple languages to serve Bahá'í communities around the world.",
